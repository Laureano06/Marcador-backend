# Esta versión usa la API pública de ESPN, que no requiere cuenta ni
# API key. No hay nada que configurar acá salvo, opcionalmente, estos dos:

# Cuánto tiempo se reutiliza el dato de un día antes de volver a pedirlo
# (en milisegundos).
CACHE_TTL_MS=300000

# Puerto donde corre el servidor
PORT=3001
