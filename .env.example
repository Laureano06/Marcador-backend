# Tu API key de https://sports.bzzoiro.com/register/ (Cuenta -> API key).
# El fútbol es gratis en su plan free — no hace falta tarjeta.
BSD_API_KEY=tu_api_key_aca

# Límite diario de requests de tu plan. El plan free de fútbol de BSD es
# 7.500/día — dejalo así salvo que hayas contratado "Football Unlimited"
# (sin límite diario) o algo distinto.
API_DAILY_LIMIT=7500

# Zona horaria con la que se arma el corte "hoy/ayer/mañana" del feed y
# los TTL por fecha. BSD siempre devuelve horarios en UTC — esto es solo
# para nuestra propia lógica de qué día es "hoy". Cambiala solo si tu
# público principal no es de Argentina.
APP_TIMEZONE=America/Argentina/Buenos_Aires

# Puerto donde corre el servidor
PORT=3001
