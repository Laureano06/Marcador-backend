# Tu API key de https://dashboard.api-football.com (plan free: 100
# requests/día). NO es la de RapidAPI, es la que te muestra el dashboard
# directo bajo "My Access".
API_FOOTBALL_KEY=tu_api_key_aca

# Cuánto tiempo se reutiliza el dato de un día antes de volver a pedirlo a
# la API externa (en milisegundos). Con el plan free (100 req/día) no
# conviene bajar esto de unos minutos.
CACHE_TTL_MS=300000

# Puerto donde corre el servidor
PORT=3001
