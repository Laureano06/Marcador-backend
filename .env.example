# Tu API key de https://dashboard.api-football.com (la de "My Access",
# NO es la de RapidAPI).
API_FOOTBALL_KEY=tu_api_key_aca

# Límite diario de requests de tu plan. El plan free es 100 — dejalo así
# salvo que hayas contratado un plan pago con más cuota.
API_DAILY_LIMIT=100

# Zona horaria con la que se cortan los "días" al pedir partidos. Sin
# esto, la API corta los días en UTC — un partido a las 21hs en
# Argentina aparecía agrupado en el día siguiente. Cambiala solo si tu
# público principal no es de Argentina.
API_FOOTBALL_TIMEZONE=America/Argentina/Buenos_Aires

# Puerto donde corre el servidor
PORT=3001
