# Tu API key de https://dashboard.api-football.com (la de "My Access",
# NO es la de RapidAPI).
API_FOOTBALL_KEY=ece80ef877faed11c9c9818a420dda93

# Límite diario de requests de tu plan. El plan free es 100 — dejalo así
# salvo que hayas contratado un plan pago con más cuota.
API_DAILY_LIMIT=100

# Temporada actual, para los endpoints que la necesitan (tabla de
# posiciones, partidos de una liga). API-Football nombra la temporada por
# el año en que arrancó (la 2026-27 europea es "2026").
API_FOOTBALL_SEASON=2026

# Cuánto tiempo se reutiliza el feed de partidos de un día antes de
# volver a pedirlo (en milisegundos). No conviene bajar esto con solo
# 100 requests/día disponibles.
CACHE_TTL_MS=1200000

# Puerto donde corre el servidor
PORT=3001
